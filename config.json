{
    "model": {
        "block_size": 512,
        "n_embd": 768,
        "n_layer": 12,
        "vocab_size": 50304
    },
    "generation": {
        "max_new_tokens": 256,
        "temperature": 0.7,
        "top_k": 40,
        "top_p": 0.9,
        "repetition_penalty": 1.3
    },
    "training": {
        "batch_size": 4,
        "grad_accum_steps": 4,
        "max_iters": 5000,
        "eval_interval": 200,
        "learning_rate": 3e-5,
        "dropout": 0.1,
        "grad_clip": 1.0,
        "patience": 5
    },
    "agents": {
        "web": {
            "enabled": true,
            "module": "web",
            "function": "search",
            "timeout": 8
        }
    },
    "search_triggers": [
        "what",
        "who",
        "where",
        "when",
        "why",
        "how",
        "is",
        "are",
        "was",
        "were",
